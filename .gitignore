# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境变量（真实配置不入库，.env.example 才是模板）
.env

# 运行时产物
uploads/
logs/

# 前端（frontend/ 源码入库；node_modules 与 dist 不入库，
