# ============================================================
# 企业知识库 RAG 后端 — 环境变量模板
# 使用方法：复制本文件为 .env 并修改实际值
# 说明：所有配置禁止硬编码，统一从这里读取（app/config/settings.py）
# ============================================================

# ---------- 应用 ----------
APP_NAME=RAG Knowledge Base Service
APP_VERSION=0.1.0
# 调试模式：true 时返回详细错误信息（生产必须为 false）
DEBUG=false

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000

# ---------- 文件上传 ----------
# 上传文件存储目录（相对路径基于项目根目录解析）
UPLOAD_DIR=uploads
# 单文件大小上限（MB）
MAX_UPLOAD_SIZE_MB=20
# 允许的后缀名，逗号分隔（解析时自动转小写、去空格）
ALLOWED_EXTENSIONS=.txt,.pdf

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------- 文本清洗（false 时跳过对应规则） ----------
CLEAN_REMOVE_INVISIBLE=true
CLEAN_COLLAPSE_NEWLINES=true
CLEAN_COLLAPSE_SPACES=true

# ---------- 解析预览 ----------
PREVIEW_MAX_CHARS=200

# ---------- 文本分块 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------- MySQL（第二阶段） ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=rag_knowledge

# ---------- Embedding（第三阶段） ----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
HF_ENDPOINT=https://hf-mirror.com

# ---------- Milvus 向量库（第三阶段） ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=doc_chunks
MILVUS_METRIC=COSINE
MILVUS_INDEX_TYPE=HNSW

# ============================================================
# 以下为后续阶段预留配置（本阶段不生效，先注释占位）
# ============================================================

# ---------- 大模型服务：本地 deepseek-harness（第五阶段） ----------

