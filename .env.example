# ============================================================
# 企业知识库 RAG 后端 — 环境变量模板
# 使用方法：复制本文件为 .env 并修改实际值
# 说明：所有配置禁止硬编码，统一从这里读取（app/config/settings.py）
# ============================================================

# ---------- 应用 ----------
APP_NAME=RAG Knowledge Base Service
APP_VERSION=0.1.0
# 调试模式：true 时返回详细错误信息（生产必须为 false）
DEBUG=false

# 注意：服务监听地址/端口由 uvicorn 命令行参数决定
# （uvicorn app.main:app --host 0.0.0.0 --port 8000），此处不配置

# ---------- 文件上传 ----------
# 上传文件存储目录（相对路径基于项目根目录解析）
UPLOAD_DIR=uploads
# 单文件大小上限（MB）
MAX_UPLOAD_SIZE_MB=20
# 允许的后缀名，逗号分隔（解析时自动转小写、去空格）
# 说明：.txt/.md 用原生轻量解析；.pdf 由 PDF_PARSER 决定解析器；
#       .doc/.docx/.ppt/.pptx/.xls/.xlsx 与 .png/.jpg/.jpeg 交给本地 MinerU 解析
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.png,.jpg,.jpeg

# ---------- 本地 MinerU 4.0 ----------
# MinerU 4.0 V1 API 服务根地址，不含 /v1；默认应用端口 8000 已被本项目占用，建议 MinerU 使用 8001
# 本地 MinerU 服务默认无鉴权，不配置 API Key
PDF_PARSER=pdfplumber
MINERU_API_URL=http://127.0.0.1:8001
MINERU_TIER=standard
MINERU_TIMEOUT_SECONDS=300
MINERU_MAX_POLLS=100
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_CONNECT_RETRIES=3
MINERU_RETRY_BACKOFF_SECONDS=2

# ---------- 异步文档 worker（第九阶段） ----------
DOCUMENT_WORKER_ENABLED=true
DOCUMENT_WORKER_POLL_SECONDS=1
DOCUMENT_WORKER_TIMEOUT_SECONDS=900
DOCUMENT_WORKER_MAX_ATTEMPTS=3
DOCUMENT_WORKER_RETRY_DELAY_SECONDS=30
DOCUMENT_ASSET_DIR=uploads/assets

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------- 文本清洗（false 时跳过对应规则） ----------
CLEAN_REMOVE_INVISIBLE=true
CLEAN_COLLAPSE_NEWLINES=true
CLEAN_COLLAPSE_SPACES=true

# ---------- 解析预览 ----------
PREVIEW_MAX_CHARS=200

# ---------- 文本分块 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------- MySQL（第二阶段） ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=rag_knowledge

# ---------- Embedding（第三阶段） ----------
# 二选一：本地已下载模型路径（推荐，离线可用）或 HuggingFace 仓库名（联网下载）
# EMBEDDING_MODEL=D:/path/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 有 NVIDIA 独显填 cuda，否则填 cpu
EMBEDDING_DEVICE=cpu
HF_ENDPOINT=https://hf-mirror.com

# ---------- Milvus 向量库（第三阶段） ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 存哪（集合名）
MILVUS_COLLECTION=doc_chunks
# 怎么算相似（余弦）
MILVUS_METRIC=COSINE
# 怎么查得快（HNSW）
MILVUS_INDEX_TYPE=HNSW

# ---------- 大模型服务（第五/十阶段，OpenAI 兼容格式） ----------
# deepseek：使用云端 DeepSeek；ollama：使用本机 Ollama OpenAI 兼容接口
LLM_PROVIDER=deepseek
# 官方 DeepSeek API：https://api.deepseek.com（国内无需代理）
# 若改接本地 harness，填本地地址并在实现里调整认证头
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-v4-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# 检索时取回最相似的4个文档片段作为上下文
RAG_TOP_K=4
# 大模型生成时的随机性
RAG_TEMPERATURE=0.3
# 单次回答的最大输出token（词元）
RAG_MAX_TOKENS=1024
# 相似度阈值门槛，余弦相似度低于0.3的片段会被丢弃
RAG_MIN_SIMILARITY=0.3
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1
RAG_MAX_QUERY_CHARS=2000
RAG_MAX_QUERY_TOKENS=1024
LLM_MAX_INPUT_TOKENS=8192
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# -------- 参数配合补充---------
#MILVUS和RAG配合起来的流程（示例）：
#1. 用 COSINE + HNSW 从 `doc_chunks` 里找出最相似的候选；
#2. 只保留相似度 ≥ 0.3 的片段，最多取 4 条；
#3. 把这 4 条拼进 Prompt，让模型以 0.3 的温度、最多 1024 token 生成回答。

# ---------- 容器部署（仅 deploy/docker-compose.yml 使用） ----------
# 注意：下面前缀为 *_HOST_* 的变量由 docker compose 的「变量插值」读取，
#       来源是 deploy/.env 或当前 shell 环境变量；本文件是「应用」配置，
#       不参与 compose 插值（已实测：放这里无效）。
# 宿主模型目录（compose 直接挂载本地权重，离线可用、无需 ollama pull）：
#   留空/不设时使用默认相对路径（相对 deploy/ 上溯两级 = 工作区根目录）
#   OLLAMA_MODELS_HOST_PATH 默认 → ../../models    （Ollama 模型仓库，含 qwen3:8b）
#   EMBEDDING_MODEL_HOST_PATH 默认 → ../../bge-m3  （bge-m3 权重，1024 维）
#   目录不同时建议写绝对路径（示例）：
# OLLAMA_MODELS_HOST_PATH=D:\models\ollama
# EMBEDDING_MODEL_HOST_PATH=D:\models\bge-m3
# 宿主端口覆盖（默认：后端 8000 / MinerU 8001 / MySQL 3307 / Milvus 19530 /
#   MinIO 9000+9001 / Ollama 11434）：
# BACKEND_HOST_PORT=8000
# MINERU_HOST_PORT=8001
# MYSQL_HOST_PORT=3307
# MILVUS_HOST_PORT=19530
# OLLAMA_HOST_PORT=11434
# Ollama 模型常驻时长（容器内默认 30m，避免每次问答重新加载 5.2GB 模型）
# OLLAMA_KEEP_ALIVE=30m
# 容器内 Embedding 设备：compose 默认 cuda（镜像内 torch 2.14+cu130 实测支持 RTX 5080 / sm_120，
#   且 backend 已预留 GPU）；显存紧张时在这里写 cpu 退回 CPU（查询向量化会慢一个数量级）
# EMBEDDING_DEVICE=cpu

# ============================================================
# 以下为后续阶段预留配置（本阶段不生效，先注释占位）
# ============================================================
